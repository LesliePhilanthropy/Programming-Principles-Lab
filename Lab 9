import random

# Prompt the user for N
N = int(input("N: "))

# Create two arrays with N random numbers
array1 = []
array2 = []

for i in range(N):
    array1.append(random.randint(0, 500))
    array2.append(random.randint(0, 500))

# Combine both arrays without duplicates
final_array = []

for number in array1:
    if number not in final_array:
        final_array.append(number)

for number in array2:
    if number not in final_array:
        final_array.append(number)

# Display the final array, one number per line
for number in final_array:
    print(number)
