# Is the number prime?
def is_prime(number):
    if number == 1:
        return True
    elif number < 1:
        return False

    for i in range(2, number):
        if number % i == 0:
            return False

    return True

# Start and ending numbers
start = int(input("Starting Number: "))
end = int(input("Ending Number: "))

# Display the prime numbers
for number in range(start, end + 1):
    if is_prime(number):
        print(number)
